{
  "scoring_cascade": {
    "low_threshold": 0.2,
    "high_threshold": 0.75,
    "high_score_llm_fraction": 0.3,
    "high_score_random_fraction": 0.3,
    "low_score_sample_fraction": 0.01,
    "default_priority_strategy": "balanced",
    "percentile_bucketing": true,
    "low_percentile": 20.0,
    "high_percentile": 75.0,
    "percentile_min_links": 10,
    "max_llm_links_per_node": 60,
    "llm_batch_size": null
  },
  "embeddings": {
    "backend": "sentence_transformers",
    "model_name": "all-MiniLM-L6-v2",
    "flush_interval_seconds": 60.0,
    "flush_threshold": 50,
    "buffer_max_size": 500
  },
  "export": {
    "batch_size": 1
  },
  "fetch": {
    "min_delay": 1.0,
    "jitter_max": 0.2,
    "backoff_start": 1.0,
    "backoff_max": 10.0,
    "backoff_growth": 2.0,
    "backoff_success_decay": 0.5,
    "backoff_failure_decay": 0.5,
    "http_total_timeout": 30.0,
    "http_connect_timeout": 10.0,
    "respect_robots": true,
    "robots_ttl_seconds": 0.0,
    "user_agent": "CrawlViz/1.0 (+https://github.com/omarbounawarapy/crawlviz; omar.bounawara.py@gmail.com)",
    "accept": "text/html,application/xhtml+xml,application/xml;q=0.9,image/webp,*/*;q=0.8",
    "accept_encoding": "gzip, deflate",
    "accept_language": "",
    "extra_headers": {}
  },
  "pipelines": {
    "processing": {
      "workers": 1,
      "max_queue_size": null
    },
    "requests": {
      "workers": 4,
      "max_queue_size": null
    },
    "scoring": {
      "workers": 1,
      "max_queue_size": null
    },
    "storage": {
      "workers": 1,
      "max_queue_size": null
    },
    "filtering": {
      "workers": 10,
      "max_queue_size": null
    },
    "priority": {
      "workers": 10,
      "max_queue_size": null
    },
    "transformation": {
      "workers": 3,
      "max_queue_size": null
    },
    "debugging": {
      "workers": 2,
      "max_queue_size": null
    },
    "retry": {
      "workers": 1,
      "max_queue_size": null
    }
  },
  "retries": {
    "max_request_retries": 3,
    "max_scoring_retries": 3,
    "base_delay": 2.0,
    "growth": 2.0,
    "empty_score_demotion": 5,
    "fetch_retry_demotion": 2
  },
  "priority": {
    "nlp_bias": 60,
    "llm_bias": 40,
    "aggressive_weights": {
      "target_similarity": 0.4,
      "coverage_gap": 0.15,
      "novelty_injection": 0.1,
      "contextual_consistency": 0.05,
      "depth_penalty": 0.08
    },
    "balanced_weights": {
      "target_similarity": 0.25,
      "novelty_injection": 0.2,
      "coverage_gap": 0.15,
      "contextual_consistency": 0.1,
      "lexical_overlap": 0.05,
      "depth_penalty": 0.05
    },
    "exploration_weights": {
      "novelty_injection": 0.35,
      "cluster_distance": 0.25,
      "coverage_gap": 0.2,
      "target_similarity": 0.05,
      "semantic_delta": 0.05,
      "depth_penalty": 0.03
    }
  },
  "url": {
    "strip_fragment": true,
    "strip_trailing_slash": true
  },
  "nlp": {
    "composite_weights": {
      "target_similarity": 0.8,
      "contextual_consistency": 0.05,
      "boilerplate_score": -0.35
    },
    "target_top_k": 2,
    "cluster_eps": 0.3,
    "cluster_min_samples": 2,
    "link_context_length": 100
  },
  "llm": {
    "max_tokens": null,
    "temperature": null,
    "key_cooldown_seconds": 0.0
  },
  "observability": {
    "debug_enabled": true,
    "ui_port": 8765,
    "snapshot_max_candidates": 4000,
    "snapshot_max_errors": 1000
  },
  "run": {
    "seed": null,
    "stop_check_interval": 0.1,
    "shutdown_grace": 5.0
  },
  "prompts": {
    "scoring_system": "You are a semantic relevance scoring engine for a focused web crawler.\n\nYour job is to evaluate candidate links and assign:\n- a relevance score (0 to 100)\n- a relevance type\n- optional semantic expansions\n\nReturn ONLY valid JSON.\nNo markdown.\nNo explanation outside JSON.",
    "scoring_rules": "RULES:\n- Each candidate URL is independent\n- Use strategy_context as soft bias only\n- Score range: integer 0\u2013100\n- Assign exactly one relevance_type:\n  direct | partial | irrelevant | ambiguous\n- Generate 2\u20134 semantic expansions per link\n- Expansions must be conceptual, not copied text",
    "strategy_contexts": {
      "TOPICAL": "Focus on direct semantic relevance to the target topic. Penalize navigation pages.",
      "PATHFINDING": "Prefer links that are useful intermediate steps toward reaching the target topic.",
      "EXPLORATION": "Prefer semantically diverse links to broaden coverage.",
      "GOAL_ORIENTED": "Prefer links that directly help achieve the target objective.",
      "DENSITY_FOCUSED": "Prefer content-rich links such as definitions and explanations.",
      "UNCERTAINTY_BIASED": "Prefer ambiguous links that may reveal new semantic areas."
    }
  },
  "providers": {
    "endpoints": {
      "openrouter": "https://openrouter.ai/api/v1/chat/completions",
      "openai": "https://api.openai.com/v1/chat/completions",
      "anthropic": "https://api.anthropic.com/v1/messages",
      "gemini": "https://generativelanguage.googleapis.com/v1beta/models",
      "nvidia": "https://integrate.api.nvidia.com/v1/chat/completions",
      "groq": "https://api.groq.com/openai/v1/chat/completions"
    }
  }
}
